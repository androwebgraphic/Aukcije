
RewriteEngine on

# 1. Prisilni HTTPS i WWW (tvoj postojeći kod)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^origo\.hr$ [OR]
RewriteCond %{HTTP_HOST} ^www\.origo\.hr$
RewriteRule ^(.*)$ "https://www.origo.hr/$1" [R=301,L]

# 2. Preusmjeravanje nepostojećih ruta na početnu stranicu
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Postavke za JS datoteke
<FilesMatch "\.js$">
    Header set Content-Type "application/javascript; charset=UTF-8"
</FilesMatch>

# Kompresija: bez ovoga se glavni JS bundle (~1.3 MB) šalje nekomprimiran.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Brotli je bolji od gzipa kad ga hosting podržava.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # Vite u naziv buildanih JS/CSS datoteka ubacuje hash, pa se mogu
    # keširati trajno. HTML se ne smije keširati jer referencira nove hashove.
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff2?|ttf|eot|png|jpe?g|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>